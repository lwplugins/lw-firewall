#: includes/Admin/SettingsPage.php:67 includes/Admin/SettingsPage.php:68
#: includes/SiteManager/Integration.php:42
msgid "Firewall"
msgstr "Tűzfal"

#: includes/Admin/SettingsPage.php:137
msgid ""
"The settings screen files are missing. Re-install the plugin from a release "
"ZIP, or run \"npm install && npm run build\" in the plugin directory."
msgstr ""
"A beállítások képernyő fájljai hiányoznak. Telepítsd újra a bővítményt egy "
"kiadási ZIP-ből, vagy futtasd a \"npm install && npm run build\" parancsot a "
"bővítmény mappájában."

#: includes/Admin/Status/StatusWarnings.php:49
msgid ""
"LW_FIREWALL_DISABLE_WORKER is set in wp-config.php, so the worker performs "
"no checks at all."
msgstr ""
"Az LW_FIREWALL_DISABLE_WORKER be van állítva a wp-config.php-ban, ezért a "
"worker semmilyen ellenőrzést nem végez."

#: includes/Admin/Status/StatusWarnings.php:53
msgid ""
"The firewall is switched off (General → Enable Firewall). No request is "
"filtered."
msgstr ""
"A tűzfal ki van kapcsolva (Általános → Firewall engedélyezése). Egyetlen "
"kérés sincs szűrve."

#: includes/Admin/Status/StatusWarnings.php:57
msgid ""
"The MU-plugin worker is not installed, so runtime protection is off. "
"Reinstall it below."
msgstr ""
"Az MU-plugin worker nincs telepítve, ezért a futásidejű védelem ki van "
"kapcsolva. Telepítsd újra lent."

#: includes/Admin/Status/StatusWarnings.php:59
msgid ""
"The installed worker does not match this plugin version, so runtime "
"protection is off until it is reinstalled."
msgstr ""
"A telepített worker nem egyezik ezzel a bővítményverzióval, ezért a "
"futásidejű védelem ki van kapcsolva, amíg újra nem települ."

#: includes/Admin/Status/StatusWarnings.php:61
msgid ""
"The worker file is installed but has never reported in. If this stays after "
"a few page loads, the worker cannot load the plugin — most often because the "
"plugin directory was renamed. Reinstall it below."
msgstr ""
"A worker fájl telepítve van, de még egyszer sem jelentkezett. Ha ez néhány "
"oldalbetöltés után is így marad, a worker nem tudja betölteni a bővítményt — "
"leggyakrabban azért, mert átnevezték a bővítmény mappáját. Telepítsd újra "
"lent."

#. translators: %s: reason the install failed
#: includes/Admin/Status/StatusWarnings.php:68
#, php-format
msgid "The last worker install attempt failed: %s"
msgstr "Az utolsó worker-telepítési kísérlet sikertelen: %s"

#: includes/Admin/Status/StatusWarnings.php:72
msgid ""
"The mu-plugins directory is not writable, so the worker cannot be installed "
"or updated automatically."
msgstr ""
"Az mu-plugins mappa nem írható, ezért a worker nem telepíthető és nem "
"frissíthető automatikusan."

#: includes/Admin/Status/StatusWarnings.php:92
msgid ""
"The file storage directory is not writable, so rate limits, bans and "
"counters cannot be stored."
msgstr ""
"A fájltároló mappa nem írható, ezért a rate limitek, kitiltások és számlálók "
"nem tárolhatók."

#. translators: %s: detected IP address
#: includes/Admin/Status/StatusWarnings.php:113
#, php-format
msgid ""
"Your request reaches the firewall as %s, which is not routable on the "
"internet. If visitors arrive the same way, they all share one rate-limit "
"bucket, one ban and one country — list the proxy or load balancer under IP "
"Rules → Reverse Proxy. If you are browsing from a LAN or VPN, only your own "
"request may be affected."
msgstr ""
"A kérésed %s címről érkezik a tűzfalhoz, ami az interneten nem routolható. "
"Ha a látogatók is így érkeznek, mind egyetlen rate limit bucketen, egy "
"kitiltáson és egy országon osztoznak — add meg a proxyt vagy "
"terheléselosztót az IP szabályok → Fordított proxy alatt. Ha LAN-ról vagy "
"VPN-ről böngészel, lehet, hogy csak a saját kérésedet érinti."

#. translators: 1: header names, 2: REMOTE_ADDR
#: includes/Admin/Status/StatusWarnings.php:127
#, php-format
msgid ""
"The request carries %1$s, but REMOTE_ADDR %2$s is not a trusted proxy, so "
"the header is ignored. If a proxy you control sets it, add %2$s under IP "
"Rules → Trusted Proxies."
msgstr ""
"A kérés tartalmazza ezt: %1$s, de a REMOTE_ADDR (%2$s) nem megbízható proxy, "
"ezért a fejlécet figyelmen kívül hagyja. Ha egy általad kezelt proxy állítja "
"be, add hozzá a(z) %2$s címet az IP szabályok → Megbízható proxyk alatt."

#. translators: %s: comma-separated country codes
#: includes/Admin/Status/StatusWarnings.php:157
#, php-format
msgid ""
"No current CIDR list for: %s. Geo blocking lets these visitors through until "
"the lists are updated (Geo Blocking → Update CIDR lists)."
msgstr ""
"Nincs friss CIDR lista ezekhez: %s. A geo blokkolás átengedi ezeket a "
"látogatókat, amíg a listák nem frissülnek (Geo blokkolás → CIDR listák "
"frissítése)."

#. translators: %d: number of alerts
#. translators: %d: number of queued alerts.
#: includes/Admin/Status/StatusWarnings.php:174 build/index.js:3
#, php-format
msgid "%d alert could not be sent yet and will be retried on the next scan."
msgid_plural ""
"%d alerts could not be sent yet and will be retried on the next scan."
msgstr[0] ""
"%d riasztást még nem sikerült elküldeni, a következő ellenőrzéskor "
"újrapróbálja."
msgstr[1] ""
"%d riasztást még nem sikerült elküldeni, a következő ellenőrzéskor "
"újrapróbálja."

#: includes/Admin/Status/StatusWarnings.php:178 build/index.js:3
msgid ""
"The last alert email could not be sent. Check your site mail configuration "
"(SMTP plugin, hosting mail limits) — an alert that never arrives is no alert "
"at all."
msgstr ""
"A legutóbbi riasztó e-mailt nem sikerült elküldeni. Érdemes ellenőrizni az "
"oldal levélküldési beállításait (SMTP bővítmény, tárhely levélkorlátok) — az "
"a riasztás, ami sosem érkezik meg, nem riasztás."

#: includes/Admin/Status/StorageProbe.php:36
msgid ""
"The storage backend refused a write. Rate limits, bans and counters are not "
"being recorded."
msgstr ""
"A tárolóréteg elutasított egy írást. A rate limitek, kitiltások és számlálók "
"nem rögzülnek."

#: includes/Admin/Status/StorageProbe.php:41
msgid ""
"A value written to the storage backend could not be read back. Rate limits, "
"bans and counters are not being enforced."
msgstr ""
"A tárolórétegbe írt értéket nem sikerült visszaolvasni. A rate limitek, "
"kitiltások és számlálók nem érvényesülnek."

#: includes/Admin/Status/StorageProbe.php:47
msgid ""
"The storage backend refused a delete. Unblocking an address may not take "
"effect."
msgstr ""
"A tárolóréteg elutasított egy törlést. Egy cím feloldása lehet, hogy nem lép "
"érvénybe."

#: includes/Admin/Status/StorageProbe.php:50
msgid "Write, read and delete all succeeded."
msgstr "Az írás, olvasás és törlés is sikerült."

#: includes/Admin/Status/WorkerState.php:68
msgid "The worker was installed."
msgstr "A worker telepítve."

#: includes/Admin/WorkerInstallReasons.php:30
msgid "The worker source file inside the plugin is missing."
msgstr "A plugin worker forrásfájlja hiányzik."

#: includes/Admin/WorkerInstallReasons.php:31
msgid "The mu-plugins directory could not be created."
msgstr "Az mu-plugins mappa nem hozható létre."

#: includes/Admin/WorkerInstallReasons.php:32
msgid "The mu-plugins directory is not writable."
msgstr "Az mu-plugins mappa nem írható."

#: includes/Admin/WorkerInstallReasons.php:33
msgid "Copying the worker file failed (disk full or permission denied)."
msgstr ""
"A worker fájl másolása sikertelen (a lemez megtelt vagy nincs jogosultság)."

#: includes/Admin/WorkerInstallReasons.php:44 build/index.js:18
msgid "Unknown install error."
msgstr "Ismeretlen telepítési hiba."

#: includes/Admin/WorkerNotice.php:39
msgid "LW Firewall — protection is OFF"
msgstr "LW Firewall — a védelem KI van kapcsolva"

#: includes/Admin/WorkerNotice.php:44
msgid ""
"The MU-plugin worker is installed but its version does not match this "
"plugin. Runtime protection is disabled until it is reinstalled."
msgstr ""
"Az MU-plugin worker telepítve van, de a verziója nem egyezik ezzel a "
"pluginnal. A futásidejű védelem ki van kapcsolva, amíg újra nem települ."

#: includes/Admin/WorkerNotice.php:45
msgid ""
"The MU-plugin worker file is missing from mu-plugins/. Runtime protection is "
"disabled until it is reinstalled."
msgstr ""
"Az MU-plugin worker fájl hiányzik az mu-plugins/ mappából. A futásidejű "
