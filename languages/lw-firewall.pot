msgid "Site-Wide Hourly Cap"
msgstr ""

#: includes/Admin/Settings/ResetFields.php:68
msgid "Total reset emails the site will send in an hour. Protects your hosting mail quota and stops your domain being flagged as a spam source. 0 disables it."
msgstr ""

#: includes/Admin/Settings/ResetFields.php:81
msgid "Proof of Render"
msgstr ""

#: includes/Admin/Settings/ResetFields.php:82
msgid "Require a signed token and honeypot on the wp-login form"
msgstr ""

#: includes/Admin/Settings/ResetFields.php:83
msgid "Rejects direct POSTs that never loaded the form. Only enforced on wp-login.php, since other lost-password forms (WooCommerce, custom login pages) do not render the token. Turn this off if a login plugin replaces the wp-login form."
msgstr ""

#: includes/Admin/Settings/ResetFields.php:87
#: includes/Admin/Settings/SpamFields.php:46
msgid "Minimum Fill Time"
msgstr ""

#: includes/Admin/Settings/ResetFields.php:90
msgid "Reject submissions faster than this many seconds after the form loaded. Separate from the registration setting, so the two forms can be tuned independently."
msgstr ""

#: includes/Admin/Settings/ResetFields.php:94
#: includes/Admin/Settings/SpamFields.php:53
msgid "Token Lifetime"
msgstr ""

#: includes/Admin/Settings/ResetFields.php:97
msgid "How long a rendered lost-password form stays valid, in seconds (3600 = 1 hour)."
msgstr ""

#: includes/Admin/Settings/ResetFields.php:100
#: includes/Admin/Settings/SpamFields.php:40
msgid "Single-Use Token"
msgstr ""

#: includes/Admin/Settings/ResetFields.php:101
#: includes/Admin/Settings/SpamFields.php:41
msgid "Reject reused tokens"
msgstr ""

#: includes/Admin/Settings/ResetFields.php:102
msgid "Each rendered form may submit one reset request. Without this, a bot can load the form once and replay that token for the whole token lifetime."
msgstr ""

#: includes/Admin/Settings/ResetFields.php:105
#: includes/Admin/Settings/TabProtection.php:57
msgid "Auto-Ban"
msgstr ""

#: includes/Admin/Settings/ResetFields.php:106
msgid "Ban IPs that trip the per-IP limit or fail the token check"
msgstr ""

#: includes/Admin/Settings/ResetFields.php:107
msgid "A banned IP is blocked from the whole site by the MU-plugin worker. Account and site-wide limits never ban: they say nothing about who happened to ask last."
msgstr ""

#: includes/Admin/Settings/ResetFields.php:117
msgid "Email Alert"
msgstr ""

#: includes/Admin/Settings/ResetFields.php:118
msgid "Email me when a reset limit is reached"
msgstr ""

#: includes/Admin/Settings/ResetFields.php:119
msgid "Sends at most one message per limit per hour, to the recipients configured on the Alerts tab."
msgstr ""

#: includes/Admin/Settings/ResetFields.php:122
msgid "Block Admin Resets"
msgstr ""

#: includes/Admin/Settings/ResetFields.php:123
msgid "Never allow password reset for administrator accounts"
msgstr ""

#: includes/Admin/Settings/ResetFields.php:124
msgid "Closes the \"flood the admin inbox, then phish the reset link\" path entirely. A locked-out administrator can then only be recovered by WP-CLI or by another administrator, so leave this off unless you have that access."
msgstr ""

#: includes/Admin/Settings/SpamFields.php:30
msgid "Enable Registration Protection"
msgstr ""

#: includes/Admin/Settings/SpamFields.php:31
msgid "Block bot registrations on wp-login.php?action=register"
msgstr ""

#: includes/Admin/Settings/SpamFields.php:32
msgid "Adds a signed proof-of-render token and honeypot to the registration form. Only active when \"Anyone can register\" is enabled."
msgstr ""

#: includes/Admin/Settings/SpamFields.php:35
msgid "Honeypot"
msgstr ""

#: includes/Admin/Settings/SpamFields.php:36
msgid "Add a hidden honeypot field"
msgstr ""

#: includes/Admin/Settings/SpamFields.php:37
msgid "Catches generic bots that fill every field. Invisible to real users."
msgstr ""

#: includes/Admin/Settings/SpamFields.php:42
msgid "Stores used tokens in the firewall storage backend so each rendered form can register only once."
msgstr ""

